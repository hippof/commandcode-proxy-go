# The proxy is keyless: each request carries the caller's Command Code key in
# `Authorization: Bearer <key>` (or Anthropic's `x-api-key`). No server-side key.

# --- Server ---
COMMANDCODE_PROXY_HOST=127.0.0.1
COMMANDCODE_PROXY_PORT=8787
# Log verbosity: debug | info (default) | warn | error. info+ logs one line per
# request (an access log); use warn/error to quiet it.
# COMMANDCODE_PROXY_LOG_LEVEL=info

# Optional: model-id overrides (JSON object). An exact full-id key wins; a key of
# opus/sonnet/haiku overrides that whole family (any id containing it). Built-in
# defaults map opus -> deepseek/deepseek-v4-pro and sonnet/haiku ->
# deepseek/deepseek-v4-flash, so Claude Code works with no config.
# COMMANDCODE_MODEL_ALIASES={"opus":"zai-org/GLM-5.2"}

# --- Upstream (defaults shown) ---
# COMMANDCODE_API_BASE=https://api.commandcode.ai
# COMMANDCODE_MODELS_URL=https://api.commandcode.ai/provider/v1/models
# COMMANDCODE_CLI_VERSION=0.29.0
# COMMANDCODE_TASTE_LEARNING=false

# --- Defaults applied only when the request omits them ---
# COMMANDCODE_DEFAULT_TEMPERATURE=0.3
# COMMANDCODE_DEFAULT_MAX_TOKENS=32000
# COMMANDCODE_MAX_TOKENS_CAP=64000
# COMMANDCODE_MAX_RETRIES=2
# COMMANDCODE_TIMEOUT=300
